<Application
	x:Class="ElectronicObserver.Avalonia.App"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:equipmentCategoryScrap="clr-namespace:ElectronicObserver.Avalonia.QuestTrackerManager2.Tasks.EquipmentCategoryScrap;assembly=ElectronicObserver.Avalonia"
	xmlns:shipClass="clr-namespace:ElectronicObserver.Avalonia.QuestTrackerManager2.Conditions.ShipClass;assembly=ElectronicObserver.Avalonia"
	xmlns:system="clr-namespace:System;assembly=System.Runtime"
	>
	<Application.Styles>
		<FluentTheme DensityStyle="Compact">
			<FluentTheme.Palettes>
				<ColorPaletteResources x:Key="Light" Accent="DodgerBlue" />
				<ColorPaletteResources x:Key="Dark" Accent="DodgerBlue" />
			</FluentTheme.Palettes>
		</FluentTheme>
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
		<StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
	</Application.Styles>

	<Application.Resources>
		<FontFamily x:Key="ContentControlThemeFontFamily">Meiryo UI</FontFamily>
		<system:Double x:Key="ControlContentThemeFontSize">12</system:Double>

		<equipmentCategoryScrap:EquipmentCategoryDisplayConverter x:Key="EquipmentCategoryDisplayConverter" />
		<shipClass:ShipClassDisplayConverter x:Key="ShipClassDisplayConverter" />

		<ControlTheme
			x:Key="RemoveButton"
			BasedOn="{StaticResource {x:Type Button}}"
			TargetType="Button"
			>
			<Setter Property="Background" Value="#DC2626" />

			<Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
				<Setter Property="Background" Value="#EF4444" />
			</Style>

			<Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
				<Setter Property="Background" Value="#B91C1C" />
			</Style>
		</ControlTheme>
	</Application.Resources>
</Application>
