<UserControl
	x:Class="ElectronicObserver.Avalonia.QuestTrackerManager2.Conditions.Group.GroupConditionView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:group="clr-namespace:ElectronicObserver.Avalonia.QuestTrackerManager2.Conditions.Group"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:questTrackerManager2="clr-namespace:ElectronicObserver.Avalonia.QuestTrackerManager2"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="group:GroupConditionViewModel"
	mc:Ignorable="d"
	>
	<Border Classes="ConditionBorder">
		<StackPanel>
			<StackPanel Orientation="Horizontal">
				<ComboBox ItemsSource="{Binding Operators}" SelectedItem="{Binding Operator}" />
				<TextBlock Text="{Binding Display}" />
			</StackPanel>

			<StackPanel Orientation="Horizontal">
				<ComboBox ItemsSource="{Binding ConditionTypes}" SelectedItem="{Binding ConditionType}" />
				<Button Command="{Binding AddConditionCommand}" Content="{x:Static questTrackerManager2:QuestTrackerManagerResources.AddCondition}" />
			</StackPanel>

			<ItemsControl ItemsSource="{Binding Conditions}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<StackPanel Orientation="Horizontal">
							<ContentControl Content="{Binding}" />
							<Button
								Command="{Binding $parent[ItemsControl].((group:GroupConditionViewModel)DataContext).RemoveConditionCommand}"
								CommandParameter="{Binding}"
								Content="{x:Static questTrackerManager2:QuestTrackerManagerResources.RemoveCondition}"
								Theme="{StaticResource RemoveButton}"
								/>
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</StackPanel>
	</Border>
</UserControl>