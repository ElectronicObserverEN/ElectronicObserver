<UserControl
	x:Class="ElectronicObserver.Avalonia.QuestTrackerManager2.Conditions.Reference.ReferenceDefinitionView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:questTrackerManager2="clr-namespace:ElectronicObserver.Avalonia.QuestTrackerManager2"
	xmlns:reference="clr-namespace:ElectronicObserver.Avalonia.QuestTrackerManager2.Conditions.Reference"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="reference:ReferenceDefinitionViewModel"
	mc:Ignorable="d"
	>
	<Border Classes="ConditionBorder">
		<Expander>
			<Expander.Header>
				<TextBlock>
					<Run Text="{Binding Name}" />
					<Run Text=": " />
					<Run Text="{Binding Condition.Display}" />
				</TextBlock>
			</Expander.Header>

			<StackPanel>
				<TextBox Text="{Binding Name}" />

				<StackPanel IsVisible="{Binding Condition, Converter={x:Static ObjectConverters.IsNull}}" Orientation="Horizontal">
					<ComboBox ItemsSource="{Binding ConditionTypes}" SelectedItem="{Binding ConditionType}" />
					<Button Command="{Binding CreateConditionCommand}" Content="{x:Static questTrackerManager2:QuestTrackerManagerResources.AddCondition}" />
				</StackPanel>

				<StackPanel IsVisible="{Binding Condition, Converter={x:Static ObjectConverters.IsNotNull}}" Orientation="Horizontal">
					<ContentControl Content="{Binding Condition}" />
					<Button
						Command="{Binding RemoveConditionCommand}"
						Content="{x:Static questTrackerManager2:QuestTrackerManagerResources.RemoveCondition}"
						Theme="{StaticResource RemoveButton}"
						/>
				</StackPanel>
			</StackPanel>
		</Expander>
	</Border>
</UserControl>