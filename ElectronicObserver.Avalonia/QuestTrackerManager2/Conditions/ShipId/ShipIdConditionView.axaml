<UserControl
	x:Class="ElectronicObserver.Avalonia.QuestTrackerManager2.Conditions.ShipId.ShipIdConditionView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:shipId="clr-namespace:ElectronicObserver.Avalonia.QuestTrackerManager2.Conditions.ShipId"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="shipId:ShipIdConditionViewModel"
	mc:Ignorable="d"
	>
	<Border Classes="ConditionBorder">
		<StackPanel Orientation="Horizontal">
			<Button Command="{Binding AddShipCommand}" Content="{Binding Ship.NameEN}" />
			<ComboBox ItemsSource="{Binding RemodelComparisonTypes}" SelectedItem="{Binding RemodelComparisonType}" />
			<TextBlock Text="{Binding Display}" />
		</StackPanel>
	</Border>
</UserControl>
