<UserControl
	x:Class="ElectronicObserver.Avalonia.QuestTrackerManager2.Conditions.ShipLevel.ShipLevelConditionView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:level="clr-namespace:ElectronicObserver.Avalonia.QuestTrackerManager2.Conditions.Level"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:shipLevel="clr-namespace:ElectronicObserver.Avalonia.QuestTrackerManager2.Conditions.ShipLevel"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="shipLevel:ShipLevelConditionViewModel"
	mc:Ignorable="d"
	>
	<Border Classes="ConditionBorder">
		<StackPanel Orientation="Horizontal">
			<NumericUpDown Value="{Binding Level}" />
			<TextBlock Text="{Binding Display}" />
		</StackPanel>
	</Border>
</UserControl>
