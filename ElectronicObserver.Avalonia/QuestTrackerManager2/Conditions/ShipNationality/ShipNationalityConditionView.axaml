<UserControl
	x:Class="ElectronicObserver.Avalonia.QuestTrackerManager2.Conditions.ShipNationality.ShipNationalityConditionView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:nationality="clr-namespace:ElectronicObserver.Avalonia.QuestTrackerManager2.Conditions.Nationality"
	xmlns:shipNationality="clr-namespace:ElectronicObserver.Avalonia.QuestTrackerManager2.Conditions.ShipNationality"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="shipNationality:ShipNationalityConditionViewModel"
	mc:Ignorable="d"
	>
	<Border Classes="ConditionBorder">
		<StackPanel Orientation="Horizontal">
			<ComboBox ItemsSource="{Binding ShipNationalities}" SelectedItem="{Binding Nationality}" />
			<TextBlock Text="{Binding Display}" />
		</StackPanel>
	</Border>
</UserControl>