<UserControl
	x:Class="ElectronicObserver.Avalonia.QuestTrackerManager2.Conditions.ShipType.ShipTypeConditionView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:shipType="clr-namespace:ElectronicObserver.Avalonia.QuestTrackerManager2.Conditions.ShipType"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="shipType:ShipTypeConditionViewModel"
	mc:Ignorable="d"
	>
	<Border Classes="ConditionBorder">
		<StackPanel Orientation="Horizontal">
			<ComboBox ItemsSource="{Binding ShipTypes}" SelectedItem="{Binding ShipType}" />
			<TextBlock Text="{Binding Display}" />
		</StackPanel>
	</Border>
</UserControl>
