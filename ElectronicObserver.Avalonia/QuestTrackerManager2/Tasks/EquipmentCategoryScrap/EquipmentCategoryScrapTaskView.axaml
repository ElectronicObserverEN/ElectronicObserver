<UserControl
	x:Class="ElectronicObserver.Avalonia.QuestTrackerManager2.Tasks.EquipmentCategoryScrap.EquipmentCategoryScrapTaskView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:equipmentCategoryScrap="clr-namespace:ElectronicObserver.Avalonia.QuestTrackerManager2.Tasks.EquipmentCategoryScrap"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="equipmentCategoryScrap:EquipmentCategoryScrapTaskViewModel"
	mc:Ignorable="d"
	>
	<StackPanel Orientation="Horizontal">
		<ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}">
			<ComboBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding ., Converter={StaticResource EquipmentCategoryDisplayConverter}}" />
				</DataTemplate>
			</ComboBox.ItemTemplate>
		</ComboBox>
		<NumericUpDown Value="{Binding Progress}" />
		<NumericUpDown Value="{Binding Count}" />
		<TextBlock Text="{Binding Display}" />
	</StackPanel>
</UserControl>
