<UserControl
	x:Class="ElectronicObserver.Avalonia.QuestTrackerManager2.Tasks.Expedition.ExpeditionTaskView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:expedition="clr-namespace:ElectronicObserver.Avalonia.QuestTrackerManager2.Tasks.Expedition"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:types="clr-namespace:ElectronicObserver.Core.Types;assembly=ElectronicObserver.Core"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="expedition:ExpeditionTaskViewModel"
	mc:Ignorable="d"
	>
	<StackPanel Orientation="Horizontal">
		<ComboBox ItemsSource="{Binding Expeditions}" SelectedItem="{Binding SelectedExpedition}">
			<ComboBox.ItemTemplate>
				<DataTemplate DataType="types:IMissionData">
					<TextBlock>
						<Run Text="{Binding DisplayID}" />
						<Run Text="{Binding NameEN}" />
					</TextBlock>
				</DataTemplate>
			</ComboBox.ItemTemplate>
		</ComboBox>
		<NumericUpDown Value="{Binding Progress}" />
		<NumericUpDown Value="{Binding Count}" />
		<TextBlock Text="{Binding Display}" />
	</StackPanel>
</UserControl>
