<common:WindowBase
	x:Class="ElectronicObserver.Window.Dialog.UiBlocker.UiBlockerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:common="clr-namespace:ElectronicObserver.Common"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	xmlns:uiBlocker="clr-namespace:ElectronicObserver.Avalonia.UiBlocker;assembly=ElectronicObserver.Avalonia"
	xmlns:uiBlockerResources="clr-namespace:ElectronicObserver.Avalonia.UiBlocker.Resources;assembly=ElectronicObserver.Avalonia"
	x:Name="UiBlocker"
	Title="{x:Static uiBlockerResources:UiBlockerResources.UiBlocker}"
	Width="800"
	Height="450"
	ui:WindowHelper.UseModernWindowStyle="True"
	x:TypeArguments="uiBlocker:UiBlockerManagerViewModel"
	mc:Ignorable="d"
	>
	<ContentControl Content="{Binding WpfAvaloniaHost, ElementName=UiBlocker}" />
</common:WindowBase>
